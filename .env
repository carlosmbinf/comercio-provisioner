# Configuración local del worker. Completa los marcadores fuera de Git.
NODE_ENV=production
METEOR_DDP_ENDPOINT=wss://www.vidkar.com/websocket
PROVISIONER_ID=vidkar-comercio-provisioner-1
PROVISIONER_TOKEN=REEMPLAZAR_POR_TOKEN_ALEATORIO_DE_32_BYTES_O_MAS
PROVISIONER_HELPER_HMAC_SECRET=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
PROVISIONER_PUBLIC_IPV4=REEMPLAZAR_POR_LA_IPV4_PUBLICA_DEL_VPS

# Repositorio autorizado. Configura acceso SSH/deploy key en el VPS; no pongas tokens en la URL.
COMERCIO_REPOSITORY_URL=REEMPLAZAR_POR_URL_GIT_DEL_REPOSITORIO
COMERCIO_REPOSITORY_REF=main

# Directorios/servicios del VPS.
PROVISIONER_DEPLOY_ROOT=/opt/vidkar/comercios
PROVISIONER_STATE_DIR=/var/lib/vidkar-provisioner/state
PROVISIONER_NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
PROVISIONER_NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
PROVISIONER_ACME_WEBROOT=/var/www/letsencrypt
PROVISIONER_PRIVILEGED_HELPER=/usr/local/sbin/vidkar-commerce-helper
PROVISIONER_CERTBOT_EMAIL=carlosmbinf@gmail.com
PROVISIONER_PORT_START=5200
PROVISIONER_PORT_END=5899

# Endpoints públicos usados al compilar cada comercio.
COMERCIO_VITE_METEOR_DDP_URL=wss://4h5rhg54-3000.brs.devtunnels.ms/websocket
COMERCIO_VITE_METEOR_HTTP_URL=https://4h5rhg54-3000.brs.devtunnels.ms
COMERCIO_VITE_GOOGLE_MAPS_API_KEY=AIzaSyB6ceUfSkrOwGJvvOlnrLbfP5sT81XwmTg

# Operación del worker.
PROVISIONER_POLL_INTERVAL_MS=5000
PROVISIONER_HEARTBEAT_INTERVAL_MS=30000
PROVISIONER_DDP_CALL_TIMEOUT_MS=12000
PROVISIONER_COMMAND_TIMEOUT_MS=900000
PROVISIONER_NPM_TIMEOUT_MS=900000
PROVISIONER_CERTBOT_TIMEOUT_MS=180000
