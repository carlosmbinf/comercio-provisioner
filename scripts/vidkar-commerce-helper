#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bin
export PATH

HELPER_STATE_DIR="/var/lib/vidkar-commerce-helper"
HELPER_KEY_FILE="/etc/vidkar/commerce-helper.key"
DEPLOY_ROOT="/opt/vidkar/comercios"
WORKER_CHECKOUT_ROOT="/var/lib/vidkar-provisioner/state/checkouts"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

fail_retryable() {
  printf 'AUTO_RETRY: %s\n' "$1" >&2
  exit 75
}

verify_signature() {
  signature=$1
  shift
  case "$signature" in
    ''|*[!a-f0-9]*) fail "Operation signature is invalid." ;;
  esac
  [ "${#signature}" -eq 64 ] || fail "Operation signature is invalid."
  [ -f "$HELPER_KEY_FILE" ] && [ ! -L "$HELPER_KEY_FILE" ] || fail "Privileged helper key is not installed."
  [ "$(stat -c '%u' "$HELPER_KEY_FILE")" -eq 0 ] || fail "Privileged helper key must be owned by root."
  [ "$(stat -c '%u' /etc/vidkar)" -eq 0 ] && [ ! -L /etc/vidkar ] || fail "Privileged helper key directory must be root-owned and not a symlink."
  key_mode="$(stat -c '%a' "$HELPER_KEY_FILE")"
  case "$key_mode" in 400|600) ;; *) fail "Privileged helper key permissions must be 0400 or 0600." ;; esac
  if ! python3 - "$HELPER_KEY_FILE" "$signature" "$@" <<'PY'
import hashlib
import hmac
import pathlib
import sys

key_path, supplied_signature, *parts = sys.argv[1:]
key = pathlib.Path(key_path).read_bytes().strip()
message = ("\n".join(parts) + "\n").encode()
expected_signature = hmac.new(key, message, hashlib.sha256).hexdigest()
if len(key) < 32 or not hmac.compare_digest(supplied_signature, expected_signature):
    raise SystemExit(1)
PY
  then
    fail "Operation signature does not authorize these arguments."
  fi
}

valid_slug() {
  slug=$1
  case "$slug" in
    ''|*[!a-z0-9-]*|-*|*-) return 1 ;;
  esac
  case "$slug" in
    admin|api|app|assets|cdn|comercio|dashboard|ftp|hls|mail|mobile|ns1|ns2|proxy|root|static|status|vidkar|vpn|www) return 1 ;;
  esac
  [ "${#slug}" -ge 3 ] && [ "${#slug}" -le 40 ]
}

valid_request_id() {
  case "$1" in
    ''|*[!a-zA-Z0-9_-]*) return 1 ;;
    *) [ "${#1}" -le 128 ] ;;
  esac
}

service_user_for_slug() {
  printf 'vcommerce-%s' "$(printf '%s' "$1" | sha256sum | cut -c1-12)"
}

validate_service_user() {
  slug=$1
  run_user=$2
  [ "$run_user" = "$(service_user_for_slug "$slug")" ] || fail "Service user does not match the requested subdomain."
}

certificate_name_for_request() {
  slug=$1
  request_id=$2
  request_hash="$(printf '%s' "$request_id" | sha256sum | cut -c1-16)"
  printf 'vidkar-commerce-%s-%s' "$slug" "$request_hash"
}

certificate_has_only_hostname() {
  certificate_file=$1
  hostname=$2
  python3 - "$certificate_file" "$hostname" <<'PY'
import ssl
import sys

try:
    certificate = ssl._ssl._test_decode_cert(sys.argv[1])
except Exception:
    raise SystemExit(2)

names = [value.rstrip(".").lower() for kind, value in certificate.get("subjectAltName", ()) if kind == "DNS"]
raise SystemExit(0 if len(names) == 1 and names[0] == sys.argv[2].lower() else 1)
PY
}

certificate_is_referenced() {
  reference_cert_name=$1
  reference_live_root="/etc/letsencrypt/live/$reference_cert_name/"
  reference_archive_root="/etc/letsencrypt/archive/$reference_cert_name/"
  reference_fullchain="$(readlink -f "/etc/letsencrypt/live/$reference_cert_name/fullchain.pem" 2>/dev/null || true)"
  reference_private_key="$(readlink -f "/etc/letsencrypt/live/$reference_cert_name/privkey.pem" 2>/dev/null || true)"

  for reference_path in "$reference_live_root" "$reference_archive_root" "$reference_fullchain" "$reference_private_key"; do
    [ -n "$reference_path" ] || continue
    for config_root in /etc/nginx /etc/apache2 /etc/httpd /etc/caddy /etc/haproxy /etc/traefik /etc/lighttpd /etc/systemd/system; do
      [ -e "$config_root" ] || continue
      if [ -L "$config_root" ] || [ ! -d "$config_root" ]; then
        return 2
      fi
      if grep -R -F -q -- "$reference_path" "$config_root"; then
        return 0
      else
        reference_grep_status=$?
        [ "$reference_grep_status" -eq 1 ] || return 2
      fi
    done
  done
  return 1
}

prepare_helper_state() {
  [ "$(id -u)" -eq 0 ] || fail "The privileged helper must run as root."
  if [ -L "$HELPER_STATE_DIR" ]; then
    fail "The privileged helper state directory must not be a symlink."
  fi
  mkdir -p "$HELPER_STATE_DIR"
  chown root:root "$HELPER_STATE_DIR"
  chmod 0700 "$HELPER_STATE_DIR"
}

root_owned_private_state_file() {
  state_file=$1
  [ -f "$state_file" ] && [ ! -L "$state_file" ] \
    && [ "$(stat -c '%u:%g' "$state_file" 2>/dev/null || true)" = "0:0" ] \
    && [ "$(stat -c '%a' "$state_file" 2>/dev/null || true)" = "600" ]
}

register_request() {
  request_id=$1
  slug=$2
  run_user=$3
  prepare_helper_state
  permit_file="$HELPER_STATE_DIR/$request_id"
  domain_file="$HELPER_STATE_DIR/domain-$slug"
  if [ -e "$domain_file" ] || [ -L "$domain_file" ]; then
    root_owned_private_state_file "$domain_file" || fail "Domain registration must be a root-owned 0600 regular file."
    [ "$(cat "$domain_file")" = "$request_id" ] || fail "This subdomain is already assigned to another request."
  fi
  if [ -e "$permit_file" ] || [ -L "$permit_file" ]; then
    root_owned_private_state_file "$permit_file" || fail "Request registration must be a root-owned 0600 regular file."
    [ "$(sed -n '1p' "$permit_file")" = "$slug" ] || fail "Request ID is already bound to another subdomain."
    [ "$(sed -n '2p' "$permit_file")" = "$run_user" ] || fail "Request ID is already bound to another service user."
    return
  fi
  temporary_domain="$(mktemp "$HELPER_STATE_DIR/.domain.XXXXXX")"
  printf '%s\n' "$request_id" > "$temporary_domain"
  chown root:root "$temporary_domain"
  chmod 0600 "$temporary_domain"
  mv "$temporary_domain" "$domain_file"
  temporary_permit="$(mktemp "$HELPER_STATE_DIR/.request.XXXXXX")"
  printf '%s\n%s\n' "$slug" "$run_user" > "$temporary_permit"
  chown root:root "$temporary_permit"
  chmod 0600 "$temporary_permit"
  mv "$temporary_permit" "$permit_file"
}

require_request() {
  request_id=$1
  slug=$2
  run_user=$3
  prepare_helper_state
  permit_file="$HELPER_STATE_DIR/$request_id"
  [ -f "$permit_file" ] || fail "No privileged registration exists for this request."
  [ ! -L "$permit_file" ] || fail "Privileged request registration must not be a symlink."
  root_owned_private_state_file "$permit_file" || fail "Privileged request registration must be root-owned with mode 0600."
  [ "$(sed -n '1p' "$permit_file")" = "$slug" ] || fail "Request ID is registered for a different subdomain."
  [ "$(sed -n '2p' "$permit_file")" = "$run_user" ] || fail "Request ID is registered for a different service user."
  domain_file="$HELPER_STATE_DIR/domain-$slug"
  [ -f "$domain_file" ] && [ ! -L "$domain_file" ] || fail "Subdomain ownership record is missing or is not a regular file."
  root_owned_private_state_file "$domain_file" || fail "Subdomain ownership record must be root-owned with mode 0600."
  [ "$(cat "$domain_file")" = "$request_id" ] || fail "Subdomain is not registered to this request."
}

domain_registration_matches_request() {
  domain_registration_request_id=$1
  domain_registration_slug=$2
  domain_registration_file="$HELPER_STATE_DIR/domain-$domain_registration_slug"
  root_owned_private_state_file "$domain_registration_file" \
    && [ "$(cat "$domain_registration_file" 2>/dev/null || true)" = "$domain_registration_request_id" ]
}

restore_request_registration_from_domain() {
  restore_request_id=$1
  restore_slug=$2
  restore_run_user=$3
  restore_permit_file="$HELPER_STATE_DIR/$restore_request_id"
  if [ -e "$restore_permit_file" ] || [ -L "$restore_permit_file" ]; then
    return 1
  fi
  domain_registration_matches_request "$restore_request_id" "$restore_slug" || return 1
  register_request "$restore_request_id" "$restore_slug" "$restore_run_user"
  require_request "$restore_request_id" "$restore_slug" "$restore_run_user"
  printf '%s\n' "REQUEST_REGISTRATION_RESTORED"
}

valid_service_uid() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -gt 0 ]
}

record_service_uid() {
  request_id=$1
  slug=$2
  run_user=$3
  require_request "$request_id" "$slug" "$run_user"
  permit_file="$HELPER_STATE_DIR/$request_id"
  service_uid="$(id -u "$run_user")"
  valid_service_uid "$service_uid" || fail "Commerce service account has an invalid UID."
  recorded_uid="$(sed -n '3p' "$permit_file")"
  if [ -n "$recorded_uid" ] && [ "$recorded_uid" != "$service_uid" ]; then
    fail "Commerce service UID does not match its root-owned registration."
  fi
  temporary_permit="$(mktemp "$HELPER_STATE_DIR/.request.XXXXXX")"
  printf '%s\n%s\n%s\n' "$slug" "$run_user" "$service_uid" > "$temporary_permit"
  chown root:root "$temporary_permit"
  chmod 0600 "$temporary_permit"
  mv "$temporary_permit" "$permit_file"
}

valid_port() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]
}

valid_ipv4_shape() {
  case "$1" in ''|*[!0-9.]*|*..*|.*|*.) return 1 ;; esac
  [ "$(printf '%s' "$1" | tr -cd '.' | wc -c | tr -d ' ')" -eq 3 ]
}

validate_paths() {
  [ "$1" = "/etc/nginx/sites-available" ] || fail "NGINX sites-available path is not allowed."
  [ "$2" = "/etc/nginx/sites-enabled" ] || fail "NGINX sites-enabled path is not allowed."
  case "$3" in
    /var/www/letsencrypt|/var/www/letsencrypt/*) ;;
    *) fail "ACME webroot must be under /var/www/letsencrypt." ;;
  esac
  case "$3" in *..*|*' '*|*';'*|*'`'*|*'$'*) fail "ACME webroot contains unsafe characters." ;; esac
}

validate_directory_not_group_writable() {
  permission_directory=$1
  permission_mode="$(stat -c '%a' "$permission_directory")"
  [ "$((0$permission_mode & 0022))" -eq 0 ] \
    || fail "A managed parent directory is writable by group or other users."
}

worker_storage_owner_allowed() {
  case "$1" in
    root|vidkar-provisioner) return 0 ;;
    *) return 1 ;;
  esac
}

validate_worker_storage_directory() {
  storage_directory=$1
  [ ! -L "$storage_directory" ] && [ -d "$storage_directory" ] \
    || fail "Worker storage directory is missing or a symlink."
  storage_owner="$(stat -c '%U' "$storage_directory")"
  worker_storage_owner_allowed "$storage_owner" \
    || fail "Worker storage directory has unexpected ownership."
  validate_directory_not_group_writable "$storage_directory"
}

validate_service_home_parent() {
  [ ! -L /var/lib ] && [ -d /var/lib ] && [ "$(stat -c '%U' /var/lib)" = root ] \
    || fail "The system library root is not a root-owned real directory."
  validate_directory_not_group_writable /var/lib
  service_home_parent="/var/lib/vidkar-commerce"
  [ ! -L "$service_home_parent" ] && [ -d "$service_home_parent" ] \
    && [ "$(stat -c '%U' "$service_home_parent")" = root ] \
    || fail "Commerce service home parent is not a root-owned real directory."
  validate_directory_not_group_writable "$service_home_parent"
}

validate_orphaned_service_home() {
  orphan_uid=$1
  service_home=$2
  valid_service_uid "$orphan_uid" || fail "Orphaned service home has no valid request-owned UID."
  if getent passwd "$orphan_uid" >/dev/null; then
    fail "The recorded service UID was reassigned; refusing to remove its home."
  fi
  validate_service_home_parent
  [ ! -L "$service_home" ] && [ -d "$service_home" ] \
    && [ "$(stat -c '%u' "$service_home")" = "$orphan_uid" ] \
    || fail "Orphaned service home does not match the root-owned request UID."
}

validate_nginx_directories() {
  [ ! -L /etc/nginx ] && [ -d /etc/nginx ] && [ "$(stat -c '%U' /etc/nginx)" = root ] \
    || fail "The NGINX configuration root is not a root-owned directory."
  validate_directory_not_group_writable /etc/nginx
  for directory in "$1" "$2"; do
    [ ! -L "$directory" ] && [ -d "$directory" ] && [ "$(stat -c '%U' "$directory")" = root ] \
      || fail "An NGINX site directory is not a root-owned real directory."
    validate_directory_not_group_writable "$directory"
  done
}

validate_deploy_root() {
  for directory in /opt /opt/vidkar; do
    [ ! -L "$directory" ] || fail "Commerce deployment parent is a symlink."
    if [ -e "$directory" ]; then
      [ -d "$directory" ] && [ "$(stat -c '%U' "$directory")" = root ] \
        || fail "Commerce deployment parent is not a root-owned real directory."
      validate_directory_not_group_writable "$directory"
    fi
  done
  [ ! -L "$DEPLOY_ROOT" ] || fail "Commerce deployment root is a symlink."
  if [ -e "$DEPLOY_ROOT" ]; then
    [ -d "$DEPLOY_ROOT" ] && [ "$(stat -c '%U' "$DEPLOY_ROOT")" = root ] \
      || fail "Commerce deployment root is not a root-owned real directory."
    validate_directory_not_group_writable "$DEPLOY_ROOT"
  fi
}

check_dns() {
  hostname=$1
  expected_ipv4=$2
  valid_ipv4_shape "$expected_ipv4" || fail "Expected IPv4 is invalid."
  resolved="$(getent ahostsv4 "$hostname" | awk '{ print $1 }' | sort -u || true)"
  [ -n "$resolved" ] || fail "No A record resolves for the requested VIDKAR subdomain."
  mismatched="$(printf '%s\n' "$resolved" | grep -vx "$expected_ipv4" || true)"
  [ -z "$mismatched" ] || fail "A records do not all point to the configured VPS IPv4."
}

render_http() {
  hostname=$1
  port=$2
  acme_webroot=$3
  request_id=$4
  cat <<EOF
# Managed by VIDKAR commerce provisioner; request $request_id
server {
    listen 80;
    server_name $hostname;

    location ^~ /.well-known/acme-challenge/ {
        root $acme_webroot;
        default_type text/plain;
        try_files \$uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }
}
EOF
}

render_https() {
  hostname=$1
  port=$2
  acme_webroot=$3
  request_id=$4
  slug=${hostname%.vidkar.com}
  certificate_name="$(certificate_name_for_request "$slug" "$request_id")"
  certificate_root="/etc/letsencrypt/live/$certificate_name"
  [ -s "$certificate_root/fullchain.pem" ] || fail "The certificate chain does not exist."
  [ -s "$certificate_root/privkey.pem" ] || fail "The certificate private key does not exist."
  cat <<EOF
# Managed by VIDKAR commerce provisioner; request $request_id
server {
    listen 80;
    server_name $hostname;

    location ^~ /.well-known/acme-challenge/ {
        root $acme_webroot;
        default_type text/plain;
        try_files \$uri =404;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name $hostname;

    ssl_certificate $certificate_root/fullchain.pem;
    ssl_certificate_key $certificate_root/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }
}
EOF
}

install_site() {
  mode=$1
  slug=$2
  port=$3
  request_id=$4
  available_dir=$5
  enabled_dir=$6
  acme_webroot=$7
  expected_ipv4=$8
  run_user=$9
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_port "$port" || fail "Application port is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  case "$run_user" in ''|root|*[!a-zA-Z0-9_-]*) fail "Service user is invalid." ;; esac
  validate_service_user "$slug" "$run_user"
  validate_paths "$available_dir" "$enabled_dir" "$acme_webroot"
  validate_nginx_directories "$available_dir" "$enabled_dir"

  hostname="$slug.vidkar.com"
  check_dns "$hostname" "$expected_ipv4"
  require_request "$request_id" "$slug" "$run_user"
  mkdir -p "$acme_webroot/.well-known/acme-challenge"
  chmod 0755 "$acme_webroot" "$acme_webroot/.well-known" "$acme_webroot/.well-known/acme-challenge"
  config_file="$available_dir/$hostname.conf"
  enabled_link="$enabled_dir/$hostname.conf"
  marker="# Managed by VIDKAR commerce provisioner; request $request_id"

  if [ -e "$config_file" ] || [ -L "$config_file" ]; then
    [ -f "$config_file" ] && [ ! -L "$config_file" ] || fail "An NGINX configuration path exists and is not a managed regular file."
    grep -Fqx "$marker" "$config_file" || fail "A site configuration already exists and belongs to another task."
  fi
  if [ -L "$enabled_link" ]; then
    link_target="$(readlink "$enabled_link")"
    [ "$link_target" = "$config_file" ] || fail "An NGINX site link already exists and points elsewhere."
  elif [ -e "$enabled_link" ]; then
    fail "An NGINX site path already exists and is not the managed link."
  fi

  register_request "$request_id" "$slug" "$run_user"

  temporary_file="$(mktemp "$available_dir/.vidkar-$slug.XXXXXX")"
  trap 'rm -f "$temporary_file"' EXIT HUP INT TERM
  if [ "$mode" = "http" ]; then
    render_http "$hostname" "$port" "$acme_webroot" "$request_id" > "$temporary_file"
  else
    render_https "$hostname" "$port" "$acme_webroot" "$request_id" > "$temporary_file"
  fi
  chmod 0640 "$temporary_file"
  mv -f "$temporary_file" "$config_file"
  trap - EXIT HUP INT TERM

  if [ ! -L "$enabled_link" ]; then
    ln -s "$config_file" "$enabled_link"
  fi
  nginx -t
  systemctl reload nginx
}

remove_nginx() {
  slug=$1
  request_id=$2
  available_dir=$3
  enabled_dir=$4
  acme_webroot=$5
  run_user=$6
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  validate_service_user "$slug" "$run_user"
  validate_paths "$available_dir" "$enabled_dir" "$acme_webroot"
  validate_nginx_directories "$available_dir" "$enabled_dir"

  hostname="$slug.vidkar.com"
  config_file="$available_dir/$hostname.conf"
  enabled_link="$enabled_dir/$hostname.conf"
  marker="# Managed by VIDKAR commerce provisioner; request $request_id"
  service_unit="/etc/systemd/system/vidkar-commerce-$slug.service"

  permit_file="$HELPER_STATE_DIR/$request_id"
  if [ ! -f "$permit_file" ] || [ -L "$permit_file" ]; then
    if [ -e "$config_file" ] || [ -L "$config_file" ] || [ -e "$enabled_link" ] || [ -L "$enabled_link" ] \
      || [ -e "$service_unit" ] || [ -L "$service_unit" ]; then
      restore_request_registration_from_domain "$request_id" "$slug" "$run_user" \
        || fail "Resources exist without a verifiable root-owned request registration; manual review is required."
    else
      return 0
    fi
  fi
  require_request "$request_id" "$slug" "$run_user"

  service_unit="/etc/systemd/system/vidkar-commerce-$slug.service"
  if [ -e "$service_unit" ] || [ -L "$service_unit" ]; then
    [ -f "$service_unit" ] && [ ! -L "$service_unit" ] || fail "Refusing to remove an unexpected systemd unit path."
    grep -Fqx "# Managed by VIDKAR commerce provisioner; request $request_id" "$service_unit" || fail "Refusing to remove a systemd unit not owned by this request."
    if systemctl is-active --quiet "vidkar-commerce-$slug.service"; then
      systemctl stop "vidkar-commerce-$slug.service" || fail_retryable "Could not stop this store's systemd unit."
    fi
    systemctl disable "vidkar-commerce-$slug.service" >/dev/null 2>&1 || fail_retryable "Could not disable this store's systemd unit."
    rm -f "$service_unit" || fail_retryable "Could not remove this store's systemd unit."
  fi

  if [ -e "$enabled_link" ] || [ -L "$enabled_link" ]; then
    [ -L "$enabled_link" ] || fail "Refusing to remove an unexpected NGINX enabled path."
    link_target="$(readlink "$enabled_link")"
    [ "$link_target" = "$config_file" ] || fail "Refusing to remove an NGINX link that points outside this request."
    if [ -e "$config_file" ] || [ -L "$config_file" ]; then
      [ -f "$config_file" ] && [ ! -L "$config_file" ] || fail "Refusing to remove an unexpected NGINX configuration path."
      grep -Fqx "$marker" "$config_file" || fail "Refusing to remove an NGINX link whose configuration is not owned by this request."
    fi
    rm -f "$enabled_link" || fail_retryable "Could not remove this store's NGINX link."
  fi

  if [ -e "$config_file" ] || [ -L "$config_file" ]; then
    [ -f "$config_file" ] && [ ! -L "$config_file" ] || fail "Refusing to remove an unexpected NGINX configuration path."
    grep -Fqx "$marker" "$config_file" || fail "Refusing to remove a configuration not owned by this request."
    rm -f "$config_file" || fail_retryable "Could not remove this store's NGINX configuration."
  fi

  # Always reconcile the active NGINX config, including a retry after file removal succeeded but reload failed.
  systemctl daemon-reload || fail_retryable "Could not reload the systemd unit registry."
  nginx -t || fail_retryable "NGINX configuration validation failed after removing this store."
  systemctl reload nginx || fail_retryable "Could not reload NGINX after removing this store."
}

remove_certificate() {
  slug=$1
  request_id=$2
  available_dir=$3
  enabled_dir=$4
  run_user=$5
  allow_legacy=$6
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  validate_service_user "$slug" "$run_user"
  validate_paths "$available_dir" "$enabled_dir" "/var/www/letsencrypt"
  validate_nginx_directories "$available_dir" "$enabled_dir"
  case "$allow_legacy" in 0|1|2) ;; *) fail "Legacy certificate cleanup flag is invalid." ;; esac

  hostname="$slug.vidkar.com"
  config_file="$available_dir/$hostname.conf"
  enabled_link="$enabled_dir/$hostname.conf"
  permit_file="$HELPER_STATE_DIR/$request_id"
  certificate_marker="$HELPER_STATE_DIR/certificate-$request_id"
  if [ -e "$config_file" ] || [ -L "$config_file" ] || [ -e "$enabled_link" ] || [ -L "$enabled_link" ]; then
    fail "Refusing to remove a certificate while the requested NGINX site still exists."
  fi

  if [ ! -f "$permit_file" ] || [ -L "$permit_file" ]; then
    if [ -e "$certificate_marker" ] || [ -L "$certificate_marker" ]; then
      restore_request_registration_from_domain "$request_id" "$slug" "$run_user" \
        || fail "Certificate ownership exists without a matching root-owned request registration."
    else
      return 0
    fi
  fi
  require_request "$request_id" "$slug" "$run_user"

  owned_certificate_name=""
  if [ -e "$certificate_marker" ] || [ -L "$certificate_marker" ]; then
    [ -f "$certificate_marker" ] && [ ! -L "$certificate_marker" ] || fail "Certificate ownership marker is not a regular file."
    expected_certificate_name="$(certificate_name_for_request "$slug" "$request_id")"
    [ "$(sed -n '1p' "$certificate_marker")" = "$slug" ] \
      && [ "$(sed -n '2p' "$certificate_marker")" = "$hostname" ] \
      && [ "$(sed -n '3p' "$certificate_marker")" = "$expected_certificate_name" ] \
      || fail "Certificate ownership marker does not match this request."
    owned_certificate_name=$expected_certificate_name
  elif [ "$allow_legacy" = "1" ]; then
    printf '%s\n' "CERTIFICATE_PRESERVED_UNOWNED"
    return 0
  elif [ "$allow_legacy" = "2" ]; then
    owned_certificate_name=$hostname
  else
    return 0
  fi

  if [ -L /etc/letsencrypt ]; then
    fail "Certbot root is a symlink; certificate cleanup requires manual review."
  fi
  if [ -e /etc/letsencrypt ]; then
    [ -d /etc/letsencrypt ] && [ "$(stat -c '%U' /etc/letsencrypt)" = root ] \
      || fail "Certbot root is not a root-owned real directory."
  fi
  renewal_dir="/etc/letsencrypt/renewal"
  if [ -L "$renewal_dir" ]; then
    fail "Certbot renewal directory is a symlink; certificate cleanup requires manual review."
  fi
  if [ -e "$renewal_dir" ] && [ ! -d "$renewal_dir" ]; then
    fail "Certbot renewal path is not a directory; certificate cleanup requires manual review."
  fi
  if [ -e "$renewal_dir" ] && [ "$(stat -c '%U' "$renewal_dir")" != root ]; then
    fail "Certbot renewal directory is not root-owned."
  fi
  live_dir="/etc/letsencrypt/live"
  archive_dir="/etc/letsencrypt/archive"
  for certificate_parent in "$live_dir" "$archive_dir"; do
    if [ -L "$certificate_parent" ]; then
      fail "A Certbot lineage parent is a symlink; certificate cleanup requires manual review."
    fi
    if [ -e "$certificate_parent" ]; then
      [ -d "$certificate_parent" ] && [ "$(stat -c '%U' "$certificate_parent")" = root ] \
        || fail "A Certbot lineage parent is not a root-owned real directory."
    fi
  done
  owned_certificate_found=0
  for renewal_config in "$renewal_dir"/*.conf; do
    [ -e "$renewal_config" ] || continue
    certificate_name=${renewal_config##*/}
    certificate_name=${certificate_name%.conf}
    case "$certificate_name" in
      ''|*[!a-zA-Z0-9._-]*|*..*)
        if [ "$certificate_name" = "$owned_certificate_name" ]; then
          fail "The owned Certbot lineage has an unsafe name."
        fi
        continue
        ;;
    esac
    if [ "$certificate_name" = "$owned_certificate_name" ]; then
      owned_certificate_found=1
    else
      continue
    fi
    if [ ! -f "$renewal_config" ] || [ -L "$renewal_config" ]; then
      if [ "$certificate_name" = "$owned_certificate_name" ]; then
        fail "The owned Certbot renewal record is not a regular file."
      fi
      printf '%s\n' "CERTIFICATE_PRESERVED_UNVERIFIABLE"
      continue
    fi

    certificate_file="/etc/letsencrypt/live/$certificate_name/cert.pem"
    certificate_live_root="/etc/letsencrypt/live/$certificate_name"
    certificate_archive_root="/etc/letsencrypt/archive/$certificate_name"
    if [ -L "$certificate_live_root" ] || [ -L "$certificate_archive_root" ]; then
      fail "The request-owned Certbot lineage contains a symlinked directory."
    fi
    if [ -e "$certificate_live_root" ]; then
      [ -d "$certificate_live_root" ] && [ "$(stat -c '%U' "$certificate_live_root")" = root ] \
        || fail "The request-owned live lineage is not a root-owned real directory."
    fi
    if [ -e "$certificate_archive_root" ]; then
      [ -d "$certificate_archive_root" ] && [ "$(stat -c '%U' "$certificate_archive_root")" = root ] \
        || fail "The request-owned archive lineage is not a root-owned real directory."
    fi
    if [ ! -s "$certificate_file" ]; then
      if [ "$certificate_name" = "$owned_certificate_name" ]; then
        fail "The owned Certbot lineage is incomplete; refusing automatic deletion."
      fi
      printf '%s\n' "CERTIFICATE_PRESERVED_UNVERIFIABLE"
      continue
    fi
    if certificate_has_only_hostname "$certificate_file" "$hostname"; then
      :
    else
      certificate_status=$?
      if [ "$certificate_status" -eq 1 ]; then
        printf '%s\n' "CERTIFICATE_PRESERVED_SHARED_SAN"
      else
        printf '%s\n' "CERTIFICATE_PRESERVED_UNVERIFIABLE"
      fi
      continue
    fi

    if certificate_is_referenced "$certificate_name"; then
      printf '%s\n' "CERTIFICATE_PRESERVED_IN_USE"
      continue
    else
      reference_status=$?
      if [ "$reference_status" -ne 1 ]; then
        printf '%s\n' "CERTIFICATE_PRESERVED_UNVERIFIABLE"
        continue
      fi
    fi

    certbot delete --cert-name "$certificate_name" --non-interactive \
      || fail_retryable "Certbot could not remove an exclusive certificate lineage."
    [ ! -e "$renewal_config" ] && [ ! -L "$renewal_config" ] \
      || fail "Certbot did not remove the requested certificate lineage."
    [ ! -e "$certificate_live_root" ] && [ ! -L "$certificate_live_root" ] \
      || fail "Certbot left files in the live lineage; manual review is required."
    [ ! -e "$certificate_archive_root" ] && [ ! -L "$certificate_archive_root" ] \
      || fail "Certbot left files in the archive lineage; manual review is required."
  done

  if [ -n "$owned_certificate_name" ] && [ "$owned_certificate_found" -eq 0 ]; then
    owned_live_root="/etc/letsencrypt/live/$owned_certificate_name"
    owned_archive_root="/etc/letsencrypt/archive/$owned_certificate_name"
    if [ -e "$owned_live_root" ] || [ -L "$owned_live_root" ] \
      || [ -e "$owned_archive_root" ] || [ -L "$owned_archive_root" ]; then
      fail "The owned certificate files exist without a matching renewal record."
    fi
  fi
  if [ -e "$certificate_marker" ] || [ -L "$certificate_marker" ]; then
    rm -f "$certificate_marker" || fail_retryable "Could not remove the completed certificate ownership record."
  fi
}

remove_site() {
  slug=$1
  request_id=$2
  run_user=$3
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  validate_service_user "$slug" "$run_user"
  site_directory="$DEPLOY_ROOT/$slug"
  config_file="/etc/nginx/sites-available/$slug.vidkar.com.conf"
  enabled_link="/etc/nginx/sites-enabled/$slug.vidkar.com.conf"
  service_unit="/etc/systemd/system/vidkar-commerce-$slug.service"
  domain_file="$HELPER_STATE_DIR/domain-$slug"
  permit_file="$HELPER_STATE_DIR/$request_id"
  certificate_marker="$HELPER_STATE_DIR/certificate-$request_id"
  service_home="/var/lib/vidkar-commerce/$slug"
  if [ ! -f "$permit_file" ] || [ -L "$permit_file" ]; then
    if [ -e "$permit_file" ] || [ -L "$permit_file" ]; then
      fail "Request registration exists but is not a regular root-owned file; manual review is required."
    fi
    if [ -e "$site_directory" ] || [ -L "$site_directory" ] \
      || [ -e "$service_home" ] || [ -L "$service_home" ] \
      || getent passwd "$run_user" >/dev/null; then
      restore_request_registration_from_domain "$request_id" "$slug" "$run_user" \
        || fail "Site resources exist without a verifiable root-owned request registration; manual review is required."
    else
      if [ -e "$certificate_marker" ] || [ -L "$certificate_marker" ]; then
        fail "Certificate ownership remains without a root-owned request registration; manual review is required."
      fi
      if [ -e "$domain_file" ] || [ -L "$domain_file" ]; then
        domain_registration_matches_request "$request_id" "$slug" \
          || fail "Domain ownership record cannot be reconciled with this request; manual review is required."
        rm -f "$domain_file" || fail_retryable "Could not remove the completed domain ownership record."
      fi
      return 0
    fi
  fi
  require_request "$request_id" "$slug" "$run_user"
  validate_deploy_root
  if [ -e "$certificate_marker" ] || [ -L "$certificate_marker" ]; then
    fail "Certificate ownership must be reconciled before removing the service account."
  fi
  if [ -e "$config_file" ] || [ -L "$config_file" ] || [ -e "$enabled_link" ] || [ -L "$enabled_link" ] \
    || [ -e "$service_unit" ] || [ -L "$service_unit" ]; then
    fail "Nginx/systemd resources must be removed before the site account."
  fi
  if [ -L "$site_directory" ]; then
    fail "Refusing to remove a commerce site directory that is a symlink."
  fi
  site_exists=0
  if [ -e "$site_directory" ]; then
    [ -d "$site_directory" ] || fail "Refusing to remove an unexpected commerce site path."
    [ "$(stat -c '%U' "$site_directory")" = "$run_user" ] || fail "Commerce site directory is not owned by the registered service user."
    site_exists=1
  fi

  checkout_directory="$WORKER_CHECKOUT_ROOT/$request_id"
  if [ -L "$checkout_directory" ]; then
    fail "Refusing to remove a staging checkout symlink."
  fi
  checkout_exists=0
  if [ -e "$checkout_directory" ]; then
    [ ! -L /var/lib ] && [ -d /var/lib ] && [ "$(stat -c '%U' /var/lib)" = root ] \
      || fail "The system library root is not a root-owned real directory."
    validate_directory_not_group_writable /var/lib
    for checkout_parent in /var/lib/vidkar-provisioner /var/lib/vidkar-provisioner/state "$WORKER_CHECKOUT_ROOT"; do
      validate_worker_storage_directory "$checkout_parent"
    done
    [ -d "$checkout_directory" ] || fail "Refusing to remove an unexpected staging checkout path."
    validate_worker_storage_directory "$checkout_directory"
    checkout_exists=1
  fi

  service_account_exists=0
  orphaned_service_home=0
  if getent passwd "$run_user" >/dev/null; then
    [ "$(printf '%s' "$(getent passwd "$run_user")" | cut -d: -f6)" = "$service_home" ] || fail "Refusing to remove a service account with an unexpected home."
    validate_service_home_parent
    if [ -L "$service_home" ]; then
      fail "Commerce service home is a symlink."
    fi
    if [ -e "$service_home" ]; then
      [ -d "$service_home" ] && [ "$(stat -c '%U' "$service_home")" = "$run_user" ] \
        || fail "Commerce service home has unexpected ownership."
      service_uid="$(id -u "$run_user")"
      [ "$(stat -c '%u' "$service_home")" = "$service_uid" ] \
        || fail "Commerce service home UID does not match its account."
    fi
    record_service_uid "$request_id" "$slug" "$run_user"
    service_account_exists=1
  elif [ -e "$service_home" ] || [ -L "$service_home" ]; then
    recorded_service_uid="$(sed -n '3p' "$permit_file")"
    validate_orphaned_service_home "$recorded_service_uid" "$service_home"
    orphaned_service_home=1
  fi

  if [ "$service_account_exists" -eq 1 ]; then
    pm2_binary="$(trusted_binary pm2)"
    if [ -d "$service_home" ]; then
      stop_pm2_daemon "$run_user" "$service_home" "$pm2_binary"
    fi
    terminate_service_user_processes "$run_user"
  fi

  if [ "$checkout_exists" -eq 1 ]; then
    rm -rf -- "$checkout_directory" || fail_retryable "Could not remove the worker checkout for this store."
  fi
  if [ "$site_exists" -eq 1 ]; then
    rm -rf -- "$site_directory" || fail_retryable "Could not remove this store's site directory."
  fi
  if [ "$service_account_exists" -eq 1 ]; then
    remove_service_account "$run_user" "$service_home" "$pm2_binary"
    if getent passwd "$run_user" >/dev/null; then
      fail_retryable "The commerce service account remains after userdel."
    fi
    if [ -e "$service_home" ] || [ -L "$service_home" ]; then
      recorded_service_uid="$(sed -n '3p' "$permit_file")"
      validate_orphaned_service_home "$recorded_service_uid" "$service_home"
      rm -rf -- "$service_home" || fail_retryable "Could not remove the isolated home directory for this store."
    fi
  elif [ "$orphaned_service_home" -eq 1 ]; then
    rm -rf -- "$service_home" || fail_retryable "Could not remove the isolated home directory for this store."
  fi
  rm -f "$permit_file" || fail_retryable "Could not remove the completed request ownership record."
  [ "$(cat "$domain_file" 2>/dev/null || true)" != "$request_id" ] || rm -f "$domain_file" || fail_retryable "Could not remove the completed domain ownership record."
}

prepare_site() {
  slug=$1
  request_id=$2
  run_user=$3
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  validate_service_user "$slug" "$run_user"
  getent group vidkar-commerce >/dev/null || fail "The vidkar-commerce service group does not exist."
  validate_deploy_root
  [ ! -L /var/lib ] && [ -d /var/lib ] && [ "$(stat -c '%U' /var/lib)" = root ] \
    || fail "The system library root is not a root-owned real directory."
  validate_directory_not_group_writable /var/lib
  [ ! -L /var/lib/vidkar-commerce ] || fail "Commerce service home parent is a symlink."
  install -d -o root -g root -m 0755 "$DEPLOY_ROOT"
  install -d -o root -g root -m 0755 /var/lib/vidkar-commerce
  validate_service_home_parent
  service_home="/var/lib/vidkar-commerce/$slug"
  site_directory="$DEPLOY_ROOT/$slug"
  service_unit="/etc/systemd/system/vidkar-commerce-$slug.service"
  [ ! -L "$site_directory" ] || fail "Commerce site path is a symlink."
  [ ! -e "$site_directory" ] || fail "Commerce site path already exists."
  [ ! -e "$service_unit" ] && [ ! -L "$service_unit" ] || fail "A systemd unit already exists for this subdomain."
  if getent passwd "$run_user" >/dev/null || [ -e "$service_home" ] || [ -L "$service_home" ]; then
    fail "The isolated service account or home already exists; manual review is required."
  fi
  register_request "$request_id" "$slug" "$run_user"
  useradd --system --create-home --home-dir "$service_home" --shell /usr/sbin/nologin --gid vidkar-commerce "$run_user"
  user_entry="$(getent passwd "$run_user")"
  user_home="$(printf '%s' "$user_entry" | cut -d: -f6)"
  user_group="$(id -gn "$run_user")"
  [ "$user_home" = "$service_home" ] && [ "$user_group" = "vidkar-commerce" ] || fail "Existing commerce service account has unexpected ownership."
  record_service_uid "$request_id" "$slug" "$run_user"
  chmod 0700 "$service_home"
  install -d -o "$run_user" -g vidkar-commerce -m 0700 "$site_directory"

  pm2_binary="$(command -v pm2)"
  [ -x "$pm2_binary" ] || fail "PM2 executable is not installed."
  temporary_unit="$(mktemp /etc/systemd/system/.vidkar-commerce.XXXXXX)"
  trap 'rm -f "$temporary_unit"' EXIT HUP INT TERM
  cat > "$temporary_unit" <<EOF
# Managed by VIDKAR commerce provisioner; request $request_id
[Unit]
Description=VIDKAR commerce PM2 resurrection for $slug
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=$run_user
Group=vidkar-commerce
Environment=HOME=$service_home
Environment=PM2_HOME=$service_home/.pm2
ExecStart=$pm2_binary resurrect
ExecStop=$pm2_binary kill

[Install]
WantedBy=multi-user.target
EOF
  chmod 0600 "$temporary_unit"
  mv "$temporary_unit" "$service_unit"
  systemctl daemon-reload
}

enable_pm2() {
  slug=$1
  request_id=$2
  run_user=$3
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  validate_service_user "$slug" "$run_user"
  require_request "$request_id" "$slug" "$run_user"
  service_unit="/etc/systemd/system/vidkar-commerce-$slug.service"
  marker="# Managed by VIDKAR commerce provisioner; request $request_id"
  [ -f "$service_unit" ] && grep -Fqx "$marker" "$service_unit" || fail "Systemd unit is not owned by this request."
  systemctl enable "$service_unit"
}

write_site_environment() {
  slug=$1
  request_id=$2
  run_user=$3
  port=$4
  environment_base64=$5
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  valid_port "$port" || fail "Application port is invalid."
  validate_service_user "$slug" "$run_user"
  require_request "$request_id" "$slug" "$run_user"
  case "$environment_base64" in ''|*[!a-zA-Z0-9+/=]*) fail "Environment payload encoding is invalid." ;; esac
  [ "${#environment_base64}" -le 32768 ] || fail "Environment payload is too large."

  site_directory="$DEPLOY_ROOT/$slug"
  [ ! -L "$site_directory" ] && [ -d "$site_directory" ] || fail "Commerce site directory is missing or is a symlink."
  [ "$(stat -c '%U' "$site_directory")" = "$run_user" ] || fail "Commerce site directory is not owned by the registered service user."
  environment_file="$site_directory/.env"
  [ ! -e "$environment_file" ] && [ ! -L "$environment_file" ] || fail "Refusing to overwrite an existing commerce .env."

  decoded_file="$(mktemp "$site_directory/.env.XXXXXX")"
  trap 'rm -f "$decoded_file"' EXIT HUP INT TERM
  printf '%s' "$environment_base64" | base64 --decode > "$decoded_file" || fail "Environment payload is not valid base64."

  expected_keys="COMERCIO_HOST HOST NODE_ENV PM2_APP_NAME PORT VITE_COMERCIO_EMPRESA_ID VITE_COMERCIO_NOMBRE VITE_GOOGLE_MAPS_API_KEY VITE_METEOR_DDP_URL VITE_METEOR_HTTP_URL"
  actual_keys="$(sed 's/=.*//' "$decoded_file" | sort | tr '\n' ' ' | sed 's/ $//')"
  [ "$actual_keys" = "$(printf '%s\n' $expected_keys | sort | tr '\n' ' ' | sed 's/ $//')" ] || fail "Environment payload contains missing or unexpected keys."
  while IFS='=' read -r key value; do
    case "$key" in
      COMERCIO_HOST|HOST|NODE_ENV|PM2_APP_NAME|PORT|VITE_COMERCIO_EMPRESA_ID|VITE_COMERCIO_NOMBRE|VITE_GOOGLE_MAPS_API_KEY|VITE_METEOR_DDP_URL|VITE_METEOR_HTTP_URL) ;;
      *) fail "Environment payload contains an unexpected key." ;;
    esac
    case "$value" in \'*\') ;; *) fail "Environment values must be single-quoted dotenv strings." ;; esac
  done < "$decoded_file"

  [ "$(grep -Fxc "HOST='127.0.0.1'" "$decoded_file")" -eq 1 ] || fail "Environment HOST is not allowed."
  [ "$(grep -Fxc "NODE_ENV='production'" "$decoded_file")" -eq 1 ] || fail "Environment NODE_ENV is not allowed."
  [ "$(grep -Fxc "COMERCIO_HOST='$slug.vidkar.com'" "$decoded_file")" -eq 1 ] || fail "Environment commerce hostname does not match the request."
  mv "$decoded_file" "$environment_file"
  chown "$run_user:vidkar-commerce" "$environment_file"
  chmod 0600 "$environment_file"
  trap - EXIT HUP INT TERM
}

service_directory() {
  slug=$1
  request_id=$2
  run_user=$3
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  validate_service_user "$slug" "$run_user"
  require_request "$request_id" "$slug" "$run_user"
  directory="$DEPLOY_ROOT/$slug"
  [ ! -L "$directory" ] && [ -d "$directory" ] || fail "Commerce site directory is missing or is a symlink."
  [ "$(stat -c '%U' "$directory")" = "$run_user" ] || fail "Commerce site directory has unexpected ownership."
  printf '%s\n' "$directory"
}

trusted_binary() {
  binary_name=$1
  candidate="$(command -v "$binary_name" || true)"
  case "$candidate" in
    /usr/bin/*|/usr/local/bin/*|/usr/sbin/runuser) ;;
    *) fail "Required system binary is not installed in an approved path." ;;
  esac
  resolved="$(readlink -f "$candidate")"
  [ -f "$resolved" ] && [ -x "$resolved" ] || fail "Required system binary is unavailable."
  [ "$(stat -c '%u' "$resolved")" -eq 0 ] || fail "Required system binary must be root-owned."
  mode="$(stat -c '%a' "$resolved")"
  [ "$((0$mode & 0022))" -eq 0 ] || fail "Required system binary has unsafe write permissions."
  printf '%s\n' "$resolved"
}

run_as_commerce() {
  run_user=$1
  site_directory=$2
  shift 2
  runuser_binary="$(trusted_binary runuser)"
  environment_binary="$(trusted_binary env)"
  service_home="$(printf '%s' "$(getent passwd "$run_user")" | cut -d: -f6)"
  [ -n "$service_home" ] || fail "Commerce service account has no home directory."
  "$runuser_binary" -u "$run_user" -- "$environment_binary" -i \
    "HOME=$service_home" \
    "PM2_HOME=$service_home/.pm2" \
    "PATH=/usr/local/bin:/usr/bin:/bin" \
    "NODE_ENV=production" \
    "$environment_binary" "--chdir=$site_directory" "$@"
}

stop_pm2_daemon() {
  run_user=$1
  service_home=$2
  pm2_binary=$3
  run_as_commerce "$run_user" "$service_home" "$pm2_binary" kill \
    || fail_retryable "Could not stop this store's isolated PM2 daemon."
}

list_service_user_processes() {
  process_uid=$1
  case "$process_uid" in ''|*[!0-9]*) return 1 ;; esac
  ps_binary="$(trusted_binary ps)"
  awk_binary="$(trusted_binary awk)"
  if ! process_table="$("$ps_binary" -eo ruid=,euid=,pid=)"; then
    return 1
  fi
  printf '%s\n' "$process_table" | "$awk_binary" -v uid="$process_uid" \
    '$1 == uid || $2 == uid { print $3 }'
}

terminate_service_user_processes() {
  process_run_user=$1
  process_uid="$(id -u "$process_run_user" 2>/dev/null)" \
    || fail_retryable "Could not resolve the commerce service account UID."
  case "$process_uid" in
    ''|*[!0-9]*|0) fail "Commerce service account UID is invalid." ;;
  esac

  process_signal_attempt=1
  while [ "$process_signal_attempt" -le 5 ]; do
    process_ids="$(list_service_user_processes "$process_uid")" \
      || fail_retryable "Could not inspect processes for the commerce service account."
    [ -n "$process_ids" ] || return 0
    if [ "$process_signal_attempt" -le 3 ]; then
      process_signal=TERM
    else
      process_signal=KILL
    fi
    for process_pid in $process_ids; do
      case "$process_pid" in
        ''|*[!0-9]*) fail_retryable "Process inspection returned an invalid PID." ;;
        0|1) fail_retryable "Process inspection returned a protected system PID." ;;
      esac
      kill "-$process_signal" "$process_pid" 2>/dev/null || true
    done
    sleep 1
    process_signal_attempt=$((process_signal_attempt + 1))
  done

  process_ids="$(list_service_user_processes "$process_uid")" \
    || fail_retryable "Could not verify shutdown of the commerce service account."
  [ -z "$process_ids" ] \
    || fail_retryable "The commerce service account still owns processes after bounded TERM/KILL shutdown."
}

remove_service_account() {
  run_user=$1
  service_home=$2
  pm2_binary=$3
  delete_attempt=1
  while [ "$delete_attempt" -le 3 ]; do
    if [ -d "$service_home" ]; then
      stop_pm2_daemon "$run_user" "$service_home" "$pm2_binary"
    fi
    terminate_service_user_processes "$run_user"
    if userdel --remove "$run_user"; then
      if getent passwd "$run_user" >/dev/null; then
        fail_retryable "The commerce service account remains after userdel."
      fi
      return 0
    fi
    if ! getent passwd "$run_user" >/dev/null; then
      return 0
    fi
    if [ "$delete_attempt" -lt 3 ]; then
      sleep "$delete_attempt"
    fi
    delete_attempt=$((delete_attempt + 1))
  done
  fail_retryable "The commerce service account is still in use after bounded shutdown attempts."
}

run_npm_install() {
  slug=$1
  request_id=$2
  run_user=$3
  directory="$(service_directory "$slug" "$request_id" "$run_user")"
  npm_binary="$(trusted_binary npm)"
  run_as_commerce "$run_user" "$directory" "$npm_binary" install -f --include=dev
}

run_pm2_operation() {
  operation=$1
  slug=$2
  request_id=$3
  run_user=$4
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  validate_service_user "$slug" "$run_user"
  request_short="$(printf '%s' "$request_id" | cut -c1-12)"
  app_name="vidkar-comercio-$slug-$request_short"

  case "$operation" in
    start|save)
      directory="$(service_directory "$slug" "$request_id" "$run_user")"
      pm2_binary="$(trusted_binary pm2)"
      if [ "$operation" = "start" ]; then
        run_as_commerce "$run_user" "$directory" "$pm2_binary" start ecosystem.config.cjs --only "$app_name"
      else
        run_as_commerce "$run_user" "$directory" "$pm2_binary" save
      fi
      ;;
    delete)
      validate_deploy_root
      service_unit="/etc/systemd/system/vidkar-commerce-$slug.service"
      site_directory="$DEPLOY_ROOT/$slug"
      hostname="$slug.vidkar.com"
      config_file="/etc/nginx/sites-available/$hostname.conf"
      enabled_link="/etc/nginx/sites-enabled/$hostname.conf"
      service_home="/var/lib/vidkar-commerce/$slug"
      service_account_entry="$(getent passwd "$run_user" || true)"
      if [ -z "$service_account_entry" ]; then
        if [ ! -e "$service_unit" ] && [ ! -L "$service_unit" ] \
          && [ ! -e "$site_directory" ] && [ ! -L "$site_directory" ] \
          && [ ! -e "$config_file" ] && [ ! -L "$config_file" ] \
          && [ ! -e "$enabled_link" ] && [ ! -L "$enabled_link" ] \
          && [ ! -e "$service_home" ] && [ ! -L "$service_home" ]; then
          return 0
        fi
        require_request "$request_id" "$slug" "$run_user"
        if [ -e "$service_unit" ] || [ -L "$service_unit" ] \
          || [ -e "$site_directory" ] || [ -L "$site_directory" ] \
          || [ -e "$config_file" ] || [ -L "$config_file" ] \
          || [ -e "$enabled_link" ] || [ -L "$enabled_link" ]; then
          fail "Cannot retry PM2 cleanup while site or NGINX resources remain without the service account."
        fi
        if [ -e "$service_home" ] || [ -L "$service_home" ]; then
          recorded_service_uid="$(sed -n '3p' "$HELPER_STATE_DIR/$request_id")"
          validate_orphaned_service_home "$recorded_service_uid" "$service_home"
          return 0
        fi
        fail "Cannot stop PM2 because the registered service account is missing while site resources remain."
      fi
      if [ ! -f "$HELPER_STATE_DIR/$request_id" ] || [ -L "$HELPER_STATE_DIR/$request_id" ]; then
        restore_request_registration_from_domain "$request_id" "$slug" "$run_user" \
          || fail "The service account exists without a verifiable root-owned request registration."
      fi
      require_request "$request_id" "$slug" "$run_user"
      [ "$(printf '%s' "$service_account_entry" | cut -d: -f6)" = "$service_home" ] \
        || fail "Cannot stop PM2 because the service home does not match this store."
      validate_service_home_parent
      [ ! -L "$service_home" ] && [ -d "$service_home" ] \
        && [ "$(stat -c '%U' "$service_home")" = "$run_user" ] \
        || fail "Commerce service home is not owned by this store account."
      pm2_binary="$(trusted_binary pm2)"
      run_as_commerce "$run_user" "$service_home" "$pm2_binary" delete "$app_name" >/dev/null 2>&1 || true
      run_as_commerce "$run_user" "$service_home" "$pm2_binary" save \
        || fail_retryable "Could not save the isolated PM2 process list."
      stop_pm2_daemon "$run_user" "$service_home" "$pm2_binary"
      ;;
    *) fail "Unsupported PM2 operation." ;;
  esac
}

materialize_site() {
  slug=$1
  request_id=$2
  run_user=$3
  validate_service_user "$slug" "$run_user"
  require_request "$request_id" "$slug" "$run_user"
  checkout_directory="$WORKER_CHECKOUT_ROOT/$request_id"
  site_directory="$DEPLOY_ROOT/$slug"
  [ ! -L "$WORKER_CHECKOUT_ROOT" ] && [ -d "$WORKER_CHECKOUT_ROOT" ] || fail "Worker checkout root is missing or a symlink."
  for checkout_parent in /var/lib/vidkar-provisioner /var/lib/vidkar-provisioner/state "$WORKER_CHECKOUT_ROOT"; do
    validate_worker_storage_directory "$checkout_parent"
  done
  [ ! -L "$checkout_directory" ] && [ -d "$checkout_directory" ] || fail "Staging checkout is missing or a symlink."
  validate_worker_storage_directory "$checkout_directory"
  [ ! -L "$site_directory" ] && [ -d "$site_directory" ] || fail "Commerce site directory is missing or a symlink."
  [ "$(stat -c '%U' "$site_directory")" = "$run_user" ] || fail "Commerce site directory has unexpected ownership."
  find "$site_directory" -mindepth 1 -maxdepth 1 -print -quit | grep -q . && fail "Commerce site directory is not empty."

  archive_file="$(mktemp "$HELPER_STATE_DIR/archive.XXXXXX.tar")"
  trap 'rm -f "$archive_file"' EXIT HUP INT TERM
  tar -C "$checkout_directory" --exclude=.git -cf "$archive_file" .
  archive_members="$(tar -tf "$archive_file")"
  while IFS= read -r member; do
    [ -n "$member" ] || continue
    case "$member" in /*|../*|*/../*) fail "Repository archive contains an unsafe path." ;; esac
    base_name=${member##*/}
    case "$base_name" in
      .env|.env.*)
        case "$base_name" in .env.example|.env.sample) ;; *) fail "The commerce repository contains a tracked .env file." ;; esac
        ;;
    esac
  done <<EOF
$archive_members
EOF
  python3 - "$archive_file" "$site_directory" <<'PY'
import os
import pathlib
import shutil
import sys
import tarfile

archive_path, destination = sys.argv[1:]
root = pathlib.Path(destination).resolve()

def ensure_inside(target):
    resolved = target.resolve(strict=False)
    if os.path.commonpath((str(root), str(resolved))) != str(root):
        raise ValueError("archive path escapes the site directory")
    cursor = target.parent
    while cursor != root.parent and cursor != root:
        if cursor.is_symlink():
            raise ValueError("archive contains a symlink parent")
        cursor = cursor.parent

with tarfile.open(archive_path, "r:") as archive:
    for member in archive.getmembers():
        name = member.name[2:] if member.name.startswith("./") else member.name
        if name in ("", "."):
            continue
        relative = pathlib.PurePosixPath(name)
        if relative.is_absolute() or ".." in relative.parts:
            raise ValueError("archive contains an unsafe path")
        if not (member.isdir() or member.isfile()):
            raise ValueError("archive contains a link or special file")
        target = root.joinpath(*relative.parts)
        ensure_inside(target)
        if member.isdir():
            target.mkdir(mode=0o755, parents=True, exist_ok=True)
            continue
        target.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        ensure_inside(target)
        if target.exists() or target.is_symlink():
            raise ValueError("archive contains a duplicate or pre-existing path")
        stream = archive.extractfile(member)
        if stream is None:
            raise ValueError("archive file has no data")
        with stream, target.open("xb") as output:
            shutil.copyfileobj(stream, output)
        os.chmod(target, 0o755 if member.mode & 0o111 else 0o644)
PY
  chown -hR "$run_user:vidkar-commerce" "$site_directory"
  chmod 0700 "$site_directory"
  rm -f "$archive_file"
  trap - EXIT HUP INT TERM
  rm -rf -- "$checkout_directory"
}

issue_certificate() {
  slug=$1
  port=$2
  request_id=$3
  email=$4
  available_dir=$5
  enabled_dir=$6
  acme_webroot=$7
  expected_ipv4=$8
  run_user=$9
  valid_slug "$slug" || fail "Subdomain slug is invalid."
  valid_port "$port" || fail "Application port is invalid."
  valid_request_id "$request_id" || fail "Request ID is invalid."
  validate_paths "$available_dir" "$enabled_dir" "$acme_webroot"
  validate_nginx_directories "$available_dir" "$enabled_dir"
  validate_service_user "$slug" "$run_user"
  case "$email" in *' '*|*';'*|*'`'*|*'$'*|*@*.*) ;; *) fail "Certbot email is invalid." ;; esac

  hostname="$slug.vidkar.com"
  config_file="$available_dir/$hostname.conf"
  marker="# Managed by VIDKAR commerce provisioner; request $request_id"
  [ -f "$config_file" ] && grep -Fqx "$marker" "$config_file" || fail "The HTTP challenge site is not managed by this request."
  require_request "$request_id" "$slug" "$run_user"
  check_dns "$hostname" "$expected_ipv4"
  certificate_name="$(certificate_name_for_request "$slug" "$request_id")"
  certificate_marker="$HELPER_STATE_DIR/certificate-$request_id"
  if [ -e "$certificate_marker" ] || [ -L "$certificate_marker" ]; then
    [ -f "$certificate_marker" ] && [ ! -L "$certificate_marker" ] || fail "Certificate ownership marker is not a regular file."
    [ "$(sed -n '1p' "$certificate_marker")" = "$slug" ] \
      && [ "$(sed -n '2p' "$certificate_marker")" = "$hostname" ] \
      && [ "$(sed -n '3p' "$certificate_marker")" = "$certificate_name" ] \
      || fail "Certificate ownership marker does not match this request."
  else
    if [ -e "/etc/letsencrypt/renewal/$certificate_name.conf" ] \
      || [ -L "/etc/letsencrypt/renewal/$certificate_name.conf" ] \
      || [ -e "/etc/letsencrypt/live/$certificate_name" ] \
      || [ -L "/etc/letsencrypt/live/$certificate_name" ]; then
      fail "A certificate lineage already exists without a matching request marker; manual review is required."
    fi
    temporary_certificate_marker="$(mktemp "$HELPER_STATE_DIR/.certificate.XXXXXX")"
    printf '%s\n%s\n%s\n' "$slug" "$hostname" "$certificate_name" > "$temporary_certificate_marker"
    chown root:root "$temporary_certificate_marker"
    chmod 0600 "$temporary_certificate_marker"
    mv "$temporary_certificate_marker" "$certificate_marker"
  fi

  certbot certonly --webroot --webroot-path "$acme_webroot" --domain "$hostname" \
    --cert-name "$certificate_name" --email "$email" --agree-tos --non-interactive \
    --no-eff-email --keep-until-expiring
  certificate_file="/etc/letsencrypt/live/$certificate_name/cert.pem"
  [ -s "$certificate_file" ] || fail "The request-owned certificate was not created."
  certificate_has_only_hostname "$certificate_file" "$hostname" \
    || fail "The certificate lineage contains domains outside this store."
}

[ "${1:-}" = "--signature" ] && [ "$#" -ge 3 ] || fail "An operation signature is required."
signature=$2
shift 2
command=${1:-}
shift || true
verify_signature "$signature" "$command" "$@"
case "$command" in
  check-dns)
    [ "$#" -eq 2 ] || fail "Usage: check-dns <slug> <expected-ipv4>"
    valid_slug "$1" || fail "Subdomain slug is invalid."
    check_dns "$1.vidkar.com" "$2"
    ;;
  prepare-site)
    [ "$#" -eq 3 ] || fail "Usage: prepare-site <slug> <request-id> <service-user>"
    prepare_site "$@"
    ;;
  write-env)
    [ "$#" -eq 5 ] || fail "Usage: write-env <slug> <request-id> <service-user> <port> <base64-env>"
    write_site_environment "$@"
    ;;
  materialize-site)
      [ "$#" -eq 3 ] || fail "Usage: materialize-site <slug> <request-id> <service-user>"
    materialize_site "$@"
    ;;
  npm-install)
    [ "$#" -eq 3 ] || fail "Usage: npm-install <slug> <request-id> <service-user>"
    run_npm_install "$@"
    ;;
  pm2-start|pm2-save|pm2-delete)
    [ "$#" -eq 3 ] || fail "Usage: pm2-start|pm2-save|pm2-delete <slug> <request-id> <service-user>"
    pm2_operation=start
    [ "$command" = "pm2-save" ] && pm2_operation=save
    [ "$command" = "pm2-delete" ] && pm2_operation=delete
    run_pm2_operation "$pm2_operation" "$@"
    ;;
  enable-pm2)
    [ "$#" -eq 3 ] || fail "Usage: enable-pm2 <slug> <request-id> <service-user>"
    enable_pm2 "$@"
    ;;
  install-http|install-https)
    [ "$#" -eq 8 ] || fail "Usage: install-http|install-https <slug> <port> <request-id> <available-dir> <enabled-dir> <acme-webroot> <expected-ipv4> <service-user>"
    mode=http
    [ "$command" = "install-http" ] || mode=https
    install_site "$mode" "$@"
    ;;
  issue-certificate)
    [ "$#" -eq 9 ] || fail "Usage: issue-certificate <slug> <port> <request-id> <email> <available-dir> <enabled-dir> <acme-webroot> <expected-ipv4> <service-user>"
    issue_certificate "$@"
    ;;
  remove-nginx)
    [ "$#" -eq 6 ] || fail "Usage: remove-nginx <slug> <request-id> <available-dir> <enabled-dir> <acme-webroot> <service-user>"
    remove_nginx "$@"
    ;;
  remove-certificate)
    [ "$#" -eq 6 ] || fail "Usage: remove-certificate <slug> <request-id> <available-dir> <enabled-dir> <service-user> <allow-legacy>"
    remove_certificate "$@"
    ;;
  remove-site)
    [ "$#" -eq 3 ] || fail "Usage: remove-site <slug> <request-id> <service-user>"
    remove_site "$@"
    ;;
  *)
    fail "Unsupported operation."
    ;;
esac
